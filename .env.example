# OpenRouter (推荐，支持多种模型)
OPENROUTER_API_KEY=sk-or-v1-xxxxx
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# ============ 可用模型列表（已测试）============
# OpenRouter 模型 ID 格式：厂商/模型名
# 切换模型只需修改 OPENROUTER_MODEL 值，其他代码无需改动

# 默认使用
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# 可选模型（已通过测试）：
# OPENROUTER_MODEL=qwen/qwen3.6-plus          # 阿里通义千问最新旗舰，中文强
# OPENROUTER_MODEL=minimax/minimax-m2.7        # MiniMax M2.7，性价比高
# OPENROUTER_MODEL=moonshotai/kimi-k2.6        # 月之暗面 Kimi K2.6
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash  # DeepSeek V4 Flash版，便宜快速

# OpenAI (可选)
# OPENAI_API_KEY=sk-xxxxx
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (可选)
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
